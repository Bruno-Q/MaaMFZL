{
    "interface_version": 2,
    "name": "MaaMFZL",
    "description": "这是一个使用 MaaFramework 创建的新项目。魔法之路小助手",
    "contact": "暂无",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/Bruno-Q/MaaMFZL",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "TapTap服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "/Users/bruno/Code/MaaMFZL/.venv/bin/python",
        "child_args": [
            //"/Users/bruno/Code/MaaMFZL/agent/debug_wrapper.py"
            "/Users/bruno/Code/MaaMFZL/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "刷血缘",
            "entry": "开始刷血缘",
            "option": [
                "血缘设置"
            ]
        },
        {
            "name": "听说这里有怪兽",
            "entry": "主界面"
        },
        {
            "name": "刷新无尽词条",
            "entry": "刷新无尽词条",
            "option": [
                "无尽设置"
            ]
        },
        {
            "name": "刷无尽",
            "entry": "开始刷无尽",
            "option": [
                "无尽设置"
            ]
        },
        {
            "name": "幸运星",
            "entry": "幸运星"
        }
    ],
    "option": {
        "无尽设置": {
            "type": "input",
            "label": "无尽设置",
            "inputs": [
                {
                    "name": "blocked_affixes",
                    "label": "无尽屏蔽词条",
                    "description": "例如：连击,冰,移动,物理,绝招,闪避,暴击,攻击速度,穿透,减速,少受",
                    "default": "连击,冰,护盾,物理,闪避,暴击,攻击速度,穿透,减速,少受,移动",
                    "pipeline_type": "string",
                    "verify": "^[^,]+(,[^,]+)*$",
                    "pattern_msg": "请用逗号分隔多个词条名称"
                },
                {
                    "name": "target_count",
                    "label": "无尽战斗次数",
                    "description": "无尽战斗次数 0表示刷完体力",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "刷新无尽词条": {
                    "custom_action_param": {
                        "blocked_affixes": "{blocked_affixes}"
                    }
                },
                "无尽_战斗结束_计数": {
                    "custom_action_param": {
                        "target_count": "{target_count}"
                    }
                }
            }
        },
        "血缘设置": {
            "type": "input",
            "label": "血缘设置",
            "inputs": [
                {
                    "name": "血缘关卡",
                    "label": "血缘关卡",
                    "description": "血缘关卡, 输入要刷的关卡名称，例如地狱162",
                    "default": "地狱162",
                    "pipeline_type": "string",
                    "verify": "^.*$"
                },
                {
                    "name": "yolo_expected_labels",
                    "label": "血缘装备掉落标签",
                    "description": "0: '金', 1: '远古', 2: '紫'，3: '太古', 用逗号分隔 例如0,1,2,3 默认3",
                    "default": "3",
                    "pipeline_type": "string",
                    "verify": "^.*$"
                },
                {
                    "name": "battle_loop_sleep_sec",
                    "label": "循环检测血缘装备掉落间隔",
                    "description": "循环检测血缘装备掉落间隔 默认0.001, 单位秒",
                    "default": "0.001",
                    "pipeline_type": "string",
                    "verify": "^\\d+(\\.\\d+)?$"
                },
                {
                    "name": "battle_ltarget_count",
                    "label": "血缘战斗次数",
                    "description": "血缘战斗次数 0表示刷完钥匙",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "识别血缘装备掉落": {
                    "custom_action_param": {
                        "yolo_expected_labels": "{yolo_expected_labels}",
                        "battle_loop_sleep_sec": "{battle_loop_sleep_sec}"
                    }
                },
                "识别血缘关卡": {
                    "recognition": "OCR",
                    "expected": [
                        "{血缘关卡}"
                    ]
                },
                "血缘_战斗结束_计数": {
                    "custom_action_param": {
                        "target_count": "{battle_ltarget_count}"
                    }
                }
            }
        }
    }
}